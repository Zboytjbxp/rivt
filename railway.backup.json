{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "node --check scripts/create-logical-backup-artifact.js"
  },
  "deploy": {
    "startCommand": "npm run backup:logical-artifact",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 2,
    "drainingSeconds": 30
  }
}
