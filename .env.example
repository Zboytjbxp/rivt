PORT=8787
APP_NAME=RIVT
APP_SLUG=rivt
APP_ORIGIN=https://rivt.pro
SESSION_MAX_AGE_MS=2592000000
AUTH_METADATA_PEPPER=
REQUIRE_PILOT_INVITE=false
SIGNUP_CONSENT_VERSION=2026-06-19

# Required managed storage. Local data/file fallback is intentionally disabled.
DATABASE_URL=
TEST_DATABASE_URL=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SIGNED_URL_SECONDS=900
MAX_UPLOAD_MB=10
# Optional hard per-account storage cap (GB). Leave blank for no hard app-layer quota.
ACCOUNT_STORAGE_GB_LIMIT=
# Backward-compatible storage cap env key.
STORAGE_GB_LIMIT=

# Independent encrypted logical backups. Configure these only on the dedicated
# backup job or restore workstation, and never reuse the application's S3_*
# credentials. The complete-recovery create command additionally receives the
# application DATABASE_URL only to prove that it shares the backup connection's
# active advisory-lock namespace; do not place complete-recovery credentials on
# the web service. New artifacts require a random 32-byte key encoded as 64 hex
# characters, padded base64, or unpadded base64url.
BACKUP_DATABASE_URL=
BACKUP_DESTINATION_S3_ENDPOINT=
BACKUP_DESTINATION_S3_REGION=
BACKUP_DESTINATION_S3_BUCKET=
BACKUP_DESTINATION_S3_PREFIX=rivt/postgres
BACKUP_DESTINATION_S3_FORCE_PATH_STYLE=false
BACKUP_DESTINATION_S3_ACCESS_KEY_ID=
BACKUP_DESTINATION_S3_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_KEY=
# Read-only compatibility for restoring artifacts written by the prior key.
BACKUP_ENCRYPTION_KEY_PREVIOUS=
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_AGE_HOURS=14
BACKUP_JOB_TIMEOUT_MINUTES=45
# Fail closed outside one explicitly approved UTC calendar month. These values
# have no size/cadence override: new artifacts are fixed at 16 MiB maximum and
# one deterministic write slot at 00:00/12:00 UTC.
BACKUP_WRITE_WINDOW_START_AT=
BACKUP_WRITE_WINDOW_END_AT=
# SHA-256 of the approved normalized endpoint, region, bucket, prefix, and
# addressing mode, separated by NUL bytes. This nonsecret drift binding must
# be protected separately from the runtime destination variables.
BACKUP_WRITE_WINDOW_DESTINATION_SHA256=
BACKUP_EXPECTED_SOURCE_COMMIT=
# Full 40-character deployed source commit bound into each artifact.
SOURCE_COMMIT=

# Destructive restore settings belong only on an isolated, temporary restore
# environment. The source object must be selected by exact key, version, and
# SHA-256 digest after the read-only verifier passes.
RESTORE_DATABASE_URL=
CONFIRM_RESTORE_TARGET_ISOLATED=false
RESTORE_SOURCE_DATABASE_URL=
RESTORE_SOURCE_S3_ENDPOINT=
RESTORE_SOURCE_S3_REGION=
RESTORE_SOURCE_S3_BUCKET=
RESTORE_SOURCE_S3_PREFIX=rivt/postgres
RESTORE_SOURCE_S3_FORCE_PATH_STYLE=false
RESTORE_SOURCE_S3_ACCESS_KEY_ID=
RESTORE_SOURCE_S3_SECRET_ACCESS_KEY=
RESTORE_BACKUP_S3_KEY=
RESTORE_BACKUP_S3_VERSION_ID=
RESTORE_BACKUP_SHA256=
RESTORE_COPY_BATCH_SIZE=200
RECOVERY_RTO_MINUTES=240

# Packet 100 complete-recovery commands are dormant source only. Do not set
# these variables on the RIVT web service, Railway, a scheduler, or a workflow.
# The create/restore commands can read production data, contact providers,
# create charge-bearing immutable objects, and delete only isolated temporary
# restore data. A separate, bounded approval and dedicated runtime are required
# before changing any confirmation below to true.
# The local-memory harness is providerless but still requires both values to be
# set deliberately before `npm run recovery:harness:local`.
RECOVERY_HARNESS_MODE=
CONFIRM_RECOVERY_LOCAL_ONLY=false

# Shared one-shot command guardrails. Blank/false values intentionally make
# `recovery:create:complete-set` and `recovery:restore:complete-set` fail closed.
COMPLETE_RECOVERY_EXECUTION_MODE=
CONFIRM_COMPLETE_RECOVERY_PROVIDER_IO=false
CONFIRM_COMPLETE_RECOVERY_PRODUCTION_DATA_READ=false
CONFIRM_COMPLETE_RECOVERY_CHARGE_BEARING_ACTION=false
CONFIRM_COMPLETE_RECOVERY_CREATE=false
CONFIRM_COMPLETE_RECOVERY_SOURCE_READ_ONLY=false
CONFIRM_COMPLETE_RECOVERY_IMMUTABLE_WRITES=false
CONFIRM_COMPLETE_RECOVERY_RESTORE=false
CONFIRM_COMPLETE_RECOVERY_TARGETS_ISOLATED=false
CONFIRM_COMPLETE_RECOVERY_TEMPORARY_DATA_DELETION=false
COMPLETE_RECOVERY_RUNTIME_SOURCE_COMMIT=
# Lowercase SHA-256 over the reviewed recovery runtime files and package lock.
# Compute and approve it from the exact checkout; the command recomputes it.
COMPLETE_RECOVERY_REVIEWED_RUNTIME_SHA256=
COMPLETE_RECOVERY_MINIMUM_RETENTION_UNTIL=
COMPLETE_RECOVERY_WRITE_WINDOW_START_AT=
COMPLETE_RECOVERY_WRITE_WINDOW_END_AT=
# Create only: the source-contract retirement deadline is the write-window end.
# The proof deadline must follow it by at least five minutes, and the reviewed
# writer session must remain valid for at least five minutes after that proof
# deadline. These timestamps do not activate any provider authority.
COMPLETE_RECOVERY_RETIREMENT_PROOF_DEADLINE_AT=
COMPLETE_RECOVERY_WRITER_SESSION_EXPIRES_AT=
# Create only: absolute, restricted path outside the repository; opened once
# with create-exclusive semantics and never emitted in sanitized command output.
COMPLETE_RECOVERY_RESTRICTED_RECEIPT_PATH=

# Exact, independently reviewed store coordinates. Coordinate digests are
# lowercase SHA-256 bindings over endpoint, region, bucket, prefix, and
# addressing mode. The source prefix must remain empty so the dedicated source
# bucket is inventoried from its root. All three namespaces must be distinct.
COMPLETE_RECOVERY_SOURCE_S3_ENDPOINT=
COMPLETE_RECOVERY_SOURCE_S3_REGION=
COMPLETE_RECOVERY_SOURCE_S3_BUCKET=
COMPLETE_RECOVERY_SOURCE_S3_PREFIX=
COMPLETE_RECOVERY_SOURCE_S3_FORCE_PATH_STYLE=false
COMPLETE_RECOVERY_SOURCE_S3_COORDINATE_SHA256=
COMPLETE_RECOVERY_DESTINATION_S3_ENDPOINT=
COMPLETE_RECOVERY_DESTINATION_S3_REGION=
COMPLETE_RECOVERY_DESTINATION_S3_BUCKET=
COMPLETE_RECOVERY_DESTINATION_S3_PREFIX=
COMPLETE_RECOVERY_DESTINATION_S3_FORCE_PATH_STYLE=false
COMPLETE_RECOVERY_DESTINATION_S3_COORDINATE_SHA256=
COMPLETE_RECOVERY_RESTORE_S3_ENDPOINT=
COMPLETE_RECOVERY_RESTORE_S3_REGION=
COMPLETE_RECOVERY_RESTORE_S3_BUCKET=
COMPLETE_RECOVERY_RESTORE_S3_PREFIX=
COMPLETE_RECOVERY_RESTORE_S3_FORCE_PATH_STYLE=false
COMPLETE_RECOVERY_RESTORE_S3_COORDINATE_SHA256=

# Four dedicated least-privilege data-plane roles plus distinct future control
# and audit identities. Access-key IDs and independently
# provider-verified principal-identity hashes must all differ, and none may
# reuse the application storage runtime identity. Principal hashes belong only
# in restricted operator evidence and must be derived from provider-returned
# canonical identities; do not invent distinct values. Optional session-token
# variable names are COMPLETE_RECOVERY_SOURCE_S3_SESSION_TOKEN,
# COMPLETE_RECOVERY_DESTINATION_S3_SESSION_TOKEN,
# COMPLETE_RECOVERY_READER_S3_SESSION_TOKEN, and
# COMPLETE_RECOVERY_RESTORE_S3_SESSION_TOKEN. Omit each variable entirely when
# its reviewed credential type has no session token; an empty value is invalid.
COMPLETE_RECOVERY_SOURCE_S3_ACCESS_KEY_ID=
COMPLETE_RECOVERY_SOURCE_S3_SECRET_ACCESS_KEY=
COMPLETE_RECOVERY_DESTINATION_S3_ACCESS_KEY_ID=
COMPLETE_RECOVERY_DESTINATION_S3_SECRET_ACCESS_KEY=
COMPLETE_RECOVERY_READER_S3_ACCESS_KEY_ID=
COMPLETE_RECOVERY_READER_S3_SECRET_ACCESS_KEY=
COMPLETE_RECOVERY_RESTORE_S3_ACCESS_KEY_ID=
COMPLETE_RECOVERY_RESTORE_S3_SECRET_ACCESS_KEY=
COMPLETE_RECOVERY_SOURCE_PRINCIPAL_IDENTITY_SHA256=
COMPLETE_RECOVERY_DESTINATION_PRINCIPAL_IDENTITY_SHA256=
COMPLETE_RECOVERY_READER_PRINCIPAL_IDENTITY_SHA256=
COMPLETE_RECOVERY_RESTORE_PRINCIPAL_IDENTITY_SHA256=
COMPLETE_RECOVERY_APPLICATION_STORAGE_PRINCIPAL_IDENTITY_SHA256=
# Create-only source-contract identities. They are digests, not credentials;
# the providerless controller cannot mint live AWS evidence.
COMPLETE_RECOVERY_CONTROL_PRINCIPAL_IDENTITY_SHA256=
COMPLETE_RECOVERY_AUDITOR_PRINCIPAL_IDENTITY_SHA256=

# Restore only: select the completed set by exact ID, immutable object version,
# digest, and the accepted COMPLIANCE-retention receipt. There is no
# latest-version or unrecorded-retention fallback. Copy these only from the
# restricted create receipt; never expose the exact values in normal output.
COMPLETE_RECOVERY_SET_ID=
COMPLETE_RECOVERY_COMPLETION_VERSION_ID=
COMPLETE_RECOVERY_COMPLETION_SHA256=
COMPLETE_RECOVERY_COMPLETION_RETENTION_MODE=
COMPLETE_RECOVERY_COMPLETION_RETENTION_UNTIL=

# These commands also require the existing DATABASE_URL (create-only lock-
# namespace probe), BACKUP_DATABASE_URL, BACKUP_ENCRYPTION_KEY, SOURCE_COMMIT,
# RESTORE_DATABASE_URL, and
# CONFIRM_RESTORE_TARGET_ISOLATED settings above as applicable. A provider may
# supply RAILWAY_GIT_COMMIT_SHA for runtime attestation; never forge it locally.
# Every predecessor-key alias must remain blank for active-key-only evidence.
RIVT_BACKUP_ENCRYPTION_KEY_PREVIOUS=
COMPLETE_RECOVERY_KEY_PREVIOUS=

# Safety limits are fixed in reviewed source. Any nonblank override below is
# forbidden and makes both complete-recovery commands fail closed.
COMPLETE_RECOVERY_MAX_OBJECTS=
COMPLETE_RECOVERY_MAX_OBJECT_BYTES=
COMPLETE_RECOVERY_MAX_TOTAL_BYTES=
COMPLETE_RECOVERY_CONCURRENCY=
COMPLETE_RECOVERY_MAX_READ_ATTEMPTS=
COMPLETE_RECOVERY_MAX_INVENTORY_PAGES=
COMPLETE_RECOVERY_RESTORE_BATCH_SIZE=
COMPLETE_RECOVERY_RTO_MINUTES=

# Required before charging or verifying real users.
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Stripe Connect invoice ACH is a separate, fail-closed provider surface.
STRIPE_CONNECT_ACH_ENABLED=false
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://rivt.pro/app/profile/settings?billing=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://rivt.pro/app/profile/settings?billing=cancelled
STRIPE_PORTAL_RETURN_URL=https://rivt.pro/app/profile/settings
# Optional local/live smoke credentials. Do not set these on the Railway service.
RIVT_SMOKE_EMAIL=
RIVT_SMOKE_PASSWORD=
RIVT_BILLING_EXERCISE_REDIRECTS=false
# Local development only. Never enable for production.
VITE_ALLOW_LOCAL_PRO=false
IDENTITY_PROVIDER_KEY=
RESEND_API_KEY=
# Transactional account, security, support, and billing email sender.
EMAIL_FROM=RIVT <support@rivt.pro>
EMAIL_DELIVERY_MODE=resend
# Browser push delivery. Generate one VAPID key pair and keep the private key server-only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@rivt.pro
# Maximum exact trade + service-area recipients notified for one newly published job.
MATCHING_JOB_ALERTS_ENABLED=false
MATCHING_JOB_ALERT_LIMIT=200
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://rivt.pro/api/auth/google/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the Sign in with Apple private key with literal \n sequences or real newlines.
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=https://rivt.pro/api/auth/apple/callback
# Twilio currently powers explicit invoice SMS delivery only. Do not use these
# credentials for general alerts until per-channel consent and opt-out handling ship.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Preferred for production SMS. Twilio Messaging Service SID (MG...)
TWILIO_MESSAGING_SERVICE_SID=
# Fallback during setup if you are sending directly from a number.
TWILIO_PHONE_NUMBER=
