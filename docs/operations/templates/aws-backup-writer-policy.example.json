{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadBucketProtectionConfiguration",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketVersioning",
        "s3:GetBucketObjectLockConfiguration"
      ],
      "Resource": "arn:aws:s3:::<BUCKET>"
    },
    {
      "Sid": "WriteNewImmutableBackupObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObjectRetention"
      ],
      "Resource": "arn:aws:s3:::<BUCKET>/<PREFIX>/*"
    }
  ]
}
